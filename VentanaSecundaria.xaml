<Window x:Class="RestaurantSala.VentanaSecundaria"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resumen de Mesas y Comandas" Width="900" Height="500">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Tabla 1: Mesas -->
        <DataGrid x:Name="dgMesas" Grid.Column="0" AutoGenerateColumns="False"
              ItemsSource="{Binding Mesas}"
              SelectionMode="Single"
              SelectionChanged="dgMesas_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="Capacidad" Binding="{Binding CapacidadMaxima}" Width="90"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="150"/>
                <DataGridTextColumn Header="Comensales" Binding="{Binding ComensalesActuales}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Tabla 2: Comanda de la mesa seleccionada (si hay) -->
        <DataGrid Grid.Column="1" AutoGenerateColumns="False"
              ItemsSource="{Binding MesaSeleccionada.ComandaActual.Lineas}"
              IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Plato" Binding="{Binding Plato.Nombre}" Width="*"/>
                <DataGridTextColumn Header="Categoría" Binding="{Binding Plato.Categoria}" Width="120"/>
                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>