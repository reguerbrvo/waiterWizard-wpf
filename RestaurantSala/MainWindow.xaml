<Window x:Class="RestaurantSala.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:RestaurantSala.Converters"
        Title="waiterWizard" Width="1100" Height="700"
        Icon="Assets/waiterWizardIcon.png">
    <Window.Resources>
        <conv:EstadoToBrushConverter x:Key="EstadoToBrushConverter"/>
        <conv:OcupacionToBrushConverter x:Key="OcupacionToBrushConverter"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#D5DAE0"/>
        <CornerRadius x:Key="PanelCornerRadius">10</CornerRadius>
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="TopBarButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Archivo">
                <MenuItem Header="_Guardar sesión..." Click="OnGuardarSesionClick"/>
                <MenuItem Header="_Cargar sesión..." Click="OnCargarSesionClick"/>
                <Separator/>
                <MenuItem Header="_Salir" Click="OnSalirClick"/>
            </MenuItem>
            <MenuItem Header="_Opciones">
                <MenuItem x:Name="MenuNoPreguntar"
            Header="_No preguntar antes de reiniciar sesión"
            IsCheckable="True"
            Loaded="OnMenuNoPreguntarLoaded"
            Click="OnMenuNoPreguntarClick"/>
            </MenuItem>

        </Menu>
        <Border DockPanel.Dock="Top" Background="#EEF1F5" Padding="10">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" Padding="10" CornerRadius="{StaticResource PanelCornerRadius}"
                        BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Comensales" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Width="70" VerticalContentAlignment="Center"
                                 Text="{Binding ComensalesEntrada, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <WrapPanel Grid.Column="0" VerticalAlignment="Center" ItemHeight="36" ItemWidth="140">
                        <Button Content="Reservar" Command="{Binding CmdReservar}" Style="{StaticResource TopBarButtonStyle}"/>
                        <Button Content="Ocupar" Command="{Binding CmdOcuparSinComanda}" Style="{StaticResource TopBarButtonStyle}"/>
                        <Button Content="Liberar" Command="{Binding CmdLiberar}" Style="{StaticResource TopBarButtonStyle}"/>
                        <Button Content="Editar comanda" Command="{Binding CmdEditarComanda}" Style="{StaticResource TopBarButtonStyle}"/>
                    </WrapPanel>

                    <Border Grid.Column="1" Width="1" Margin="16,0" Background="#D5DAE0" HorizontalAlignment="Center"/>

                    <WrapPanel Grid.Column="2" VerticalAlignment="Center" ItemHeight="36" ItemWidth="150">
                        <Button Content="Nueva sesión" Command="{Binding CmdNuevaSesion}" Style="{StaticResource TopBarButtonStyle}"/>
                        <Button Content="Abrir secundaria" Click="OnAbrirSecundariaClick" Style="{StaticResource TopBarButtonStyle}"/>
                    </WrapPanel>
                </Grid>

            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*"/>
                <ColumnDefinition Width="2.4*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Canvas x:Name="PlanoSala"
                  Background="#FFF8F8F8"
                  MouseLeftButtonDown="OnPlanoSalaMouseLeftButtonDown"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Margin="12" />

                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12"
                        Padding="10" Background="White" CornerRadius="{StaticResource PanelCornerRadius}"
                        BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Opacity="0.95">
                    <StackPanel>
                        <TextBlock Text="Leyenda" FontWeight="Bold" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Rectangle Width="14" Height="14" Fill="#4E79A7" Stroke="#6B7280" StrokeThickness="0.6"/>
                            <TextBlock Text="Primeros" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Rectangle Width="14" Height="14" Fill="#59A14F" Stroke="#6B7280" StrokeThickness="0.6"/>
                            <TextBlock Text="Segundos" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="14" Height="14" Fill="#F28E2B" Stroke="#6B7280" StrokeThickness="0.6"/>
                            <TextBlock Text="Postres" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1" Margin="12" Padding="4" Background="White" BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource PanelCornerRadius}">
                <TabControl Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Background="#EEF1F5" BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Padding" Value="10,7"/>
                            <Setter Property="Margin" Value="0,0,4,0"/>
                            <Setter Property="Background" Value="#EEF1F5"/>
                            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource PanelCornerRadius}"
                                                Padding="{TemplateBinding Padding}" Margin="0,0,0,-1">
                                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                              ContentSource="Header"/> 
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#F7F9FB"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#FBFBFD"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                    <TabItem Header="Detalle" Padding="0">
                        <Border Margin="0" Padding="12" Background="#F7F9FB" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource PanelCornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#2D9CDB" CornerRadius="{StaticResource PanelCornerRadius}" Padding="10" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="☰" FontSize="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="Detalle de mesa" Foreground="White" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Nombre" FontWeight="SemiBold" Margin="0,0,12,8"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MesaSeleccionada.Nombre}" FontSize="16" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Estado" FontWeight="SemiBold" Margin="0,0,12,8"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                    <Border Width="14" Height="14" CornerRadius="{StaticResource PanelCornerRadius}" Margin="0,0,6,0"
                                            Background="{Binding MesaSeleccionada.Estado, Converter={StaticResource EstadoToBrushConverter}}"/>
                                    <TextBlock Text="{Binding MesaSeleccionada.Estado}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ocupación" FontWeight="SemiBold" Margin="0,0,12,8"/>
                                <Border Grid.Row="2" Grid.Column="1" Padding="10,6" CornerRadius="{StaticResource PanelCornerRadius}" Margin="0,0,0,8">
                                    <Border.Background>
                                        <MultiBinding Converter="{StaticResource OcupacionToBrushConverter}">
                                            <Binding Path="MesaSeleccionada.ComensalesActuales"/>
                                            <Binding Path="MesaSeleccionada.CapacidadMaxima"/>
                                        </MultiBinding>
                                    </Border.Background>
                                    <TextBlock FontWeight="SemiBold" Foreground="White">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}/{1}">
                                                <Binding Path="MesaSeleccionada.ComensalesActuales"/>
                                                <Binding Path="MesaSeleccionada.CapacidadMaxima"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Border>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Id" FontWeight="SemiBold" Margin="0,0,12,8"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MesaSeleccionada.Id}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Platos en comanda" FontWeight="SemiBold" Margin="0,0,12,0"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PlatosEnComandaSeleccionada}"/>

                                <UniformGrid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Columns="3" Margin="0,12,0,0">
                                    <Button Content="Editar comanda" Command="{Binding CmdEditarComanda}" Style="{StaticResource ActionButtonStyle}"/>
                                    <Button Content="Liberar" Command="{Binding CmdLiberar}" Style="{StaticResource ActionButtonStyle}"/>
                                    <Button Content="Reservar" Command="{Binding CmdReservar}" Style="{StaticResource ActionButtonStyle}" Margin="0"/>
                                </UniformGrid>
                            </Grid>
                        </Grid>
                    </Border>
                </TabItem>
                <TabItem Header="Estadísticas">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0" Margin="0">
                            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch">
                                <Canvas x:Name="CanvasStats" MinWidth="480" MinHeight="360" Background="White"/>
                            </Viewbox>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
        </Grid>
    </DockPanel>
</Window>
