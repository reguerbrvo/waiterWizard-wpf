<Window x:Class="RestaurantSala.VentanaSecundaria"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resumen de Mesas y Comandas" Width="900" Height="500"
        Icon="Assets/waiterWizardIcon.png"
        Background="#EEF1F5">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#D5DAE0"/>
        <CornerRadius x:Key="PanelCornerRadius">10</CornerRadius>

        <Style x:Key="CardDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#F7F9FB"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F1F4F9"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E1E6ED"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E1E6ED"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF1F5"/>
            <Setter Property="Foreground" Value="#1C1C1E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E1E6ED"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2D9CDB" CornerRadius="{StaticResource PanelCornerRadius}"
                Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📊" FontSize="18" VerticalAlignment="Center"/>
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="Resumen de actividad" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Mesas y comandas" Foreground="#F0F4F8"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" Padding="10" CornerRadius="{StaticResource PanelCornerRadius}"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Mesas" FontSize="16" FontWeight="SemiBold" Margin="2,0,0,8"/>
                    <DataGrid x:Name="dgMesas" Grid.Row="1" AutoGenerateColumns="False" Style="{StaticResource CardDataGrid}"
                              ItemsSource="{Binding Mesas}"
                              SelectionMode="Single"
                              SelectionChanged="OnMesasSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Capacidad" Binding="{Binding CapacidadMaxima}" Width="90"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="150"/>
                            <DataGridTextColumn Header="Comensales" Binding="{Binding ComensalesActuales}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" Padding="10" CornerRadius="{StaticResource PanelCornerRadius}"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Comanda" FontSize="16" FontWeight="SemiBold" Margin="2,0,0,8"/>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False" Style="{StaticResource CardDataGrid}"
                              ItemsSource="{Binding MesaSeleccionada.ComandaActual.Lineas}"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Plato" Binding="{Binding Plato.Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding Plato.Categoria}" Width="120"/>
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
