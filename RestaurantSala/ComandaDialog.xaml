<Window x:Class="RestaurantSala.ComandaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar comanda" Width="760" Height="520" WindowStartupLocation="CenterOwner"
        Background="#EEF1F5">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#D5DAE0"/>
        <CornerRadius x:Key="PanelCornerRadius">10</CornerRadius>

        <Style x:Key="CardDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#F7F9FB"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F1F4F9"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E1E6ED"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E1E6ED"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF1F5"/>
            <Setter Property="Foreground" Value="#1C1C1E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E1E6ED"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2D9CDB" CornerRadius="{StaticResource PanelCornerRadius}" Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🍽️" FontSize="18" VerticalAlignment="Center"/>
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="Editar comanda" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Añade o quita platos de la mesa" Foreground="#F0F4F8"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" Padding="10" CornerRadius="{StaticResource PanelCornerRadius}"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Carta" FontWeight="SemiBold" FontSize="16" Margin="2,0,0,8"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Carta}" SelectedItem="{Binding PlatoSeleccionado}" DisplayMemberPath="Nombre"
                             BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="Cantidad" FontWeight="SemiBold"/>
                            <TextBox Width="80" Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <Button Content="Añadir" Margin="12,18,0,0" MinWidth="100" Click="OnAgregarClick"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" Padding="10" CornerRadius="{StaticResource PanelCornerRadius}"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Lineas de comanda" FontWeight="SemiBold" FontSize="16" Margin="2,0,0,8"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Lineas}" AutoGenerateColumns="False" Style="{StaticResource CardDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Plato" Binding="{Binding Plato.Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding Plato.Categoria}" Width="120"/>
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="90"/>
                            <DataGridTemplateColumn Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Quitar" Padding="8,4" MinWidth="80" Click="OnQuitarClick"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Aceptar" Width="120" Margin="0,0,8,0" IsDefault="True" Click="OnOkClick"/>
            <Button Content="Cancelar" Width="120" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
