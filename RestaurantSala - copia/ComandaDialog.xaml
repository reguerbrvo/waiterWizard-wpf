<Window x:Class="RestaurantSala.ComandaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar comanda" Width="720" Height="460" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Carta" FontWeight="Bold" Margin="0,0,0,8"/>
            <ListBox ItemsSource="{Binding Carta}" SelectedItem="{Binding PlatoSeleccionado}" DisplayMemberPath="Nombre" Height="260"/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Cantidad:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Width="60" Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Añadir" Margin="12,0,0,0" Width="90" Click="OnAgregarClick"/>
            </StackPanel>
        </StackPanel>

        <DataGrid Grid.Column="1" ItemsSource="{Binding Lineas}" AutoGenerateColumns="False" Height="320">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Plato" Binding="{Binding Plato.Nombre}" Width="*"/>
                <DataGridTextColumn Header="Categoría" Binding="{Binding Plato.Categoria}" Width="120"/>
                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="90"/>
                <DataGridTemplateColumn Header="">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Quitar" Padding="6,2" Click="OnQuitarClick"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Aceptar" Width="100" Margin="0,0,8,0" IsDefault="True" Click="OnOkClick"/>
            <Button Content="Cancelar" Width="100" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>